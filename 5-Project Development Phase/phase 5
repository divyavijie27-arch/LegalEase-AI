import streamlit as st
from datetime import date
import google.generativeai as genai
import os

st.set_page_config(
    page_title="LegalEase",
    page_icon="⚖️"
)

st.title("⚖️ LegalEase")
st.subheader("AI-Powered Legal Document Generator")

st.warning(
    "AI-generated draft only. "
    "Professional legal review is recommended."
)

api_key = os.getenv("GEMINI_API_KEY")

if not api_key:
    st.error("Configure your Gemini API key securely.")
    st.stop()

genai.configure(api_key=api_key)
model = genai.GenerativeModel("gemini-1.5-flash")

doc_type = st.selectbox(
    "Select Document Type",
    [
        "Rental Agreement",
        "NDA - Non Disclosure Agreement",
        "Employment Offer Letter",
        "Affidavit",
        "Service Agreement"
    ]
)

document_date = st.date_input(
    "Document Date",
    value=date.today()
)

party1 = st.text_input("Party 1 Name")
party2 = st.text_input("Party 2 Name")
address1 = st.text_area("Party 1 Address")
address2 = st.text_area("Party 2 Address")
clauses = st.text_area("Additional Clauses")

if st.button("Generate Document"):
    if not party1.strip() or not party2.strip():
        st.error("Enter both party names.")
    else:
        prompt = f"""
        Create a draft {doc_type} in simple English.

        Date: {document_date}
        Party 1: {party1}
        Party 1 Address: {address1}
        Party 2: {party2}
        Party 2 Address: {address2}
        Additional Clauses: {clauses}

        Use clear headings and mark details that need
        verification. Do not invent legal facts.
        This is a draft requiring professional review.
        """

        try:
            with st.spinner("Generating document..."):
                response = model.generate_content(prompt)

            st.subheader("Generated Draft")
            st.write(response.text)

            st.download_button(
                "Download Draft",
                data=response.text,
                file_name="LegalEase_Draft.txt",
                mime="text/plain"
            )
        except Exception:
            st.error(
                "Generation failed. Check the API key, "
                "internet connection and API availability."
            )
